#include &lt;stdio.h&gt;
int main() {
int num, digit, count = 0;
printf(&quot;Enter an integer: &quot;);
scanf(&quot;%d&quot;, &amp;num);
while(num &gt; 0) {
digit = num % 10;
if(digit == 2 || digit == 3 || digit == 5 || digit == 7)
count++;
num /= 10;
}
printf(&quot;Number of prime digits = %d\n&quot;, count);
return 0;
}
