#include &lt;stdio.h&gt;
int main() {
int n, i, j;
long long fact, sum = 0;
printf(&quot;Enter a positive integer: &quot;);
scanf(&quot;%d&quot;, &amp;n);
for(i = 1; i &lt;= n; i++) {
fact = 1;
for(j = 1; j &lt;= i; j++) {
fact *= j;
}
sum += fact;
}
printf(&quot;Sum of factorials = %lld\n&quot;, sum);
return 0;
}
